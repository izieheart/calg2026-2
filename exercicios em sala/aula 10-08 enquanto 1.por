programa
{
	
	funcao inicio()
	{
		//1. Faça um algoritmo que conte de 0 a 100 e
		//mostre cada um dos valores na tela.
		inteiro num = 0

		enquanto (num < 100){
			num ++
			escreva(num, ", " )
		}
	}
}
