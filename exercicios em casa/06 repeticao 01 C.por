programa
{
	
	funcao inicio()
	{
		//C. Faca um algoritmo que calcule e mostre a soma dos 50 primeiros números começando em 1 
		//(1+2+3+4+...+50).
		inteiro soma = 0
		para (inteiro numero = 1; numero <= 50; numero++){
			soma = soma + numero
		}
		escreva("A soma dos 50 primeiros números é ", soma)
	}
}
