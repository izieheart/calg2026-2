programa
{
	
	funcao inicio()
	{
		/*2. Faça um algoritmo que receba e armazene as informações: 
			a. Código Funcionário 
			b. Idade 
			c. Tipo sanguíneo 
			d. Identidade*/
			inteiro cod, idade, id
			cadeia tipoS
			escreva("Digite o Código do Funcionário ")
			leia(cod)
			escreva("Digite a Idade do Funcuinário ")
			leia(idade)
			escreva("Digite o Tipo Sanguínio do Funcionário ")
			leia(tipoS)
			escreva("Digite a Identidade do Funcionário ")
			leia(id)

			escreva("\nCARTEIRA DE IDENTIFICAÇÃO DE FUNCIONÁRIO")
			escreva("\nCÓDIGO: ", cod)
			escreva("\nIDADE: ", idade)
			escreva("\nTIPO S: ", tipoS)
			escreva("\nID: ", id)
			
	}
}
